# 开发环境
VITE_APP_NODE_ENV=development

# 接口地址（与原 Vue 项目的 .env.development 保持一致）
VITE_APP_BASE_API=https://apitest.myweixue.com
VITE_APP_CLASS_API=https://coursetest.myweixue.com

# 本地代理（可选）：
# 1. 将 VITE_APP_BASE_API 改成 /api
# 2. 打开下面的配置后重启 dev server
# VITE_APP_PROXY_TARGET=https://apitest.myweixue.com
